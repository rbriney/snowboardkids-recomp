@@ -69,7 +79,57 @@ set(ZSTD_LEGACY_SUPPORT OFF)
 set(ZSTD_BUILD_STATIC ON)
 set(ZSTD_BUILD_SHARED OFF)
 
-add_subdirectory(src/tools/file_to_c)
+if (ANDROID)
+    # file_to_c is a host tool. On a cross-compiled Android build it must be
+    # built with the host toolchain. It is configured/built here at configure
+    # time and exposed as an imported target so all existing custom commands
+    # that reference it keep working unchanged.
+    if (CMAKE_HOST_WIN32)
+        set(SK2_FILE_TO_C_EXE "${CMAKE_BINARY_DIR}/host_tools/file_to_c_build/file_to_c.exe")
+    else()
+        set(SK2_FILE_TO_C_EXE "${CMAKE_BINARY_DIR}/host_tools/file_to_c_build/file_to_c")
+    endif()
+    if(NOT EXISTS "${SK2_FILE_TO_C_EXE}")
+        if (CMAKE_HOST_WIN32)
+            # Needs a Visual Studio developer environment (clang-cl + Windows SDK).
+            set(SK2_HOST_CC clang-cl)
+            set(SK2_HOST_CXX clang-cl)
+            set(SK2_HOST_GENERATOR -G Ninja "-DCMAKE_MAKE_PROGRAM=${CMAKE_MAKE_PROGRAM}")
+        else()
+            find_program(SK2_HOST_CXX NAMES g++ clang++ clang++-15 clang++-14 c++)
+            find_program(SK2_HOST_CC NAMES gcc clang clang-15 clang-14 cc)
+            set(SK2_HOST_GENERATOR "")
+        endif()
+        if(NOT SK2_HOST_CXX OR NOT SK2_HOST_CC)
+            message(FATAL_ERROR "Unable to find a host C++ compiler to build the file_to_c tool")
+        endif()
+        message(STATUS "Building host file_to_c tool (${SK2_HOST_CXX})")
+        execute_process(
+            COMMAND "${CMAKE_COMMAND}" -E env
+                "CC=${SK2_HOST_CC}" "CXX=${SK2_HOST_CXX}"
+                "${CMAKE_COMMAND}"
+                ${SK2_HOST_GENERATOR}
+                -S "${PROJECT_SOURCE_DIR}/src/tools/file_to_c"
+                -B "${CMAKE_BINARY_DIR}/host_tools/file_to_c_build"
+                -DCMAKE_BUILD_TYPE=Release
+            RESULT_VARIABLE SK2_FILE_TO_C_CFG_RESULT
+        )
+        if(NOT SK2_FILE_TO_C_CFG_RESULT EQUAL 0)
+            message(FATAL_ERROR "Failed to configure the host file_to_c tool")
+        endif()
+        execute_process(
+            COMMAND "${CMAKE_COMMAND}" --build "${CMAKE_BINARY_DIR}/host_tools/file_to_c_build"
+            RESULT_VARIABLE SK2_FILE_TO_C_BUILD_RESULT
+        )
+        if(NOT SK2_FILE_TO_C_BUILD_RESULT EQUAL 0)
+            message(FATAL_ERROR "Failed to build the host file_to_c tool")
+        endif()
+    endif()
+    add_executable(file_to_c IMPORTED GLOBAL)
+    set_target_properties(file_to_c PROPERTIES IMPORTED_LOCATION "${SK2_FILE_TO_C_EXE}")
+else()
+    add_subdirectory(src/tools/file_to_c)
+endif()
