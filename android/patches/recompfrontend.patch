 #define SLOT_MAP_FREE(ptr) _mm_free(ptr)
+#elif defined(__ANDROID__)
+// Android: aligned_alloc is not declared until API 28, use posix_memalign instead.
+#include <stdlib.h>
+static inline void* slot_map_aligned_alloc(size_t sizeInBytes, size_t alignment) {
+    void* p = nullptr;
+    if (posix_memalign(&p, alignment, sizeInBytes) != 0) {
+        return nullptr;
+    }
+    return p;
+}
+#define SLOT_MAP_ALLOC(sizeInBytes, alignment) slot_map_aligned_alloc(sizeInBytes, alignment)
+#define SLOT_MAP_FREE(ptr) free(ptr)
 #else
 // Posix
