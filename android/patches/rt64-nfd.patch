+// Stub implementation of the NFD (Native File Dialog) API for Android.
+// The actual file picking on Android goes through the Storage Access Framework
+// bridge (sk2_android.cpp), so NFD itself only ever reports an error here.
+// NFD_OpenDialog* should never be reached on Android: the recompui/game file
+// dialog helpers redirect to the SAF bridge first.
+#include "nfd.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+static const char kAndroidError[] = "Native file dialogs are not supported on Android";
+
